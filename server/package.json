{
  "name": "home-design-studio-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun prisma generate && bun tsc",
    "start": "bun src/index.ts",
    "db:studio": "bun prisma studio",
    "test": "bun test",
    "check": "bun tsc --noEmit && bun eslint && bun prettier --check \"src/**/*.ts\"",
    "check:fix": "bun eslint --fix && bun prettier --write \"src/**/*.ts\" && bun tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.49",
    "@hocuspocus/extension-database": "^2.15.0",
    "@hocuspocus/server": "^2.15.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@supabase/supabase-js": "^2.100.1",
    "ai": "^6.0.142",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "firebase-admin": "^13.7.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.4",
    "openai": "^4.77.0",
    "pg": "^8.20.0",
    "stripe": "^17.5.0",
    "winston": "^3.17.0",
    "yjs": "^13.6.22",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "9",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "prisma": "^7.6.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.0"
  }
}
