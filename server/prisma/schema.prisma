generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  free
  pro
}

enum SharePermission {
  readonly
  readwrite
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  incomplete
}

model User {
  id               String   @id @default(uuid())
  authSub          String   @unique @map("auth_sub")
  email            String?  @unique
  name             String?

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  subscription    Subscription?
  designs         Design[]
  createdVersions DesignVersion[]

  @@map("users")
}

// canvas_data holds the whole drawing. Walls, rooms and furniture are not tables.
model Subscription {
  id                   String              @id @default(uuid())
  userId               String              @unique @map("user_id")
  plan                 Plan                @default(free)
  status               SubscriptionStatus?

  stripeCustomerId     String?             @unique @map("stripe_customer_id")
  stripeSubscriptionId String?             @unique @map("stripe_subscription_id")
  stripePriceId        String?             @map("stripe_price_id")
  currentPeriodEnd     DateTime?           @map("current_period_end")
  cancelAtPeriodEnd    Boolean             @default(false) @map("cancel_at_period_end")

  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model BillingEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique @map("stripe_event_id")
  type          String
  userId        String?  @map("user_id")
  payload       Json
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([type])
  @@map("billing_events")
}

model Design {
  id              String           @id @default(uuid())
  name            String
  description     String?
  thumbnail       String?

  canvasData      Json             @map("canvas_data")

  userId          String           @map("user_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  members  DesignMember[]
  links    DesignLink[]
  versions DesignVersion[]

  @@index([userId])
  @@map("designs")
}

model DesignVersion {
  id          String   @id @default(uuid())
  name        String   @default("Auto-save")

  canvasData  Json     @map("canvas_data")

  designId    String   @map("design_id")
  createdById String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  design    Design @relation(fields: [designId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([designId, createdAt])
  @@map("design_versions")
}

model DesignMember {
  id         String          @id @default(uuid())
  designId   String          @map("design_id")
  email      String
  permission SharePermission @default(readonly)
  createdAt  DateTime        @default(now()) @map("created_at")

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@unique([designId, email])
  @@index([email])
  @@map("design_members")
}

model DesignLink {
  id         String          @id @default(uuid())
  designId   String          @map("design_id")
  code       String          @unique
  permission SharePermission @default(readonly)
  expiresAt  DateTime?       @map("expires_at")
  createdAt  DateTime        @default(now()) @map("created_at")

  design Design @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@index([designId])
  @@map("design_links")
}

// The catalog of placeable items. id is a slug ("sofa") so templates and the AI can
// name items without knowing this database. size is [width, depth, height] in mm.
model FurnitureItem {
  id       String @id
  name     String
  category String
  size     Json
  color    String

  @@index([category])
  @@map("furniture_items")
}

model DesignTemplate {
  id          String  @id @default(uuid())
  name        String
  description String?
  category    String
  thumbnail   String?
  canvasData  Json    @map("canvas_data")
  sortOrder   Int     @default(0) @map("sort_order")

  @@index([category])
  @@map("design_templates")
}
