PORT=4000
DATABASE_URL=postgresql://postgres:password@localhost:5432/home_design_studio

# Firebase Admin (auth) - from the service account JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI (design chat, room furnishing, image-to-design)
OPENAI_API_KEY=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# SMTP (share invite emails) - omit to skip sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

LOG_LEVEL=info
# development | production - switches log format and error verbosity
NODE_ENV=development
